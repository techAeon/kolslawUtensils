<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <!-- xsi:type must remain "TaskPaneApp" even for ribbon-command-only add-ins;
       the schema has no separate type. The buttons below use ExecuteFunction,
       so no task pane ever opens. -->

  <!-- ═══ IDENTITY ══════════════════════════════════════ -->
  <!-- Keep this GUID stable across updates -->
  <Id>a3c7f2e1-8b4d-4e6f-9c1a-2d5b7e3f8a0c</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Kolslaw</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <!-- ═══ DISPLAY ═══════════════════════════════════════ -->
  <DisplayName DefaultValue="Kolslaw TC Converter" />
  <Description DefaultValue="Converts Word tracked changes to USPTO-style markup (underline/strikethrough/brackets) and back. A Kolslaw Utensil." />

  <IconUrl DefaultValue="https://kolslaw.com/tc-converter/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://kolslaw.com/tc-converter/icon-80.png" />
  <SupportUrl DefaultValue="https://kolslaw.com" />

  <!-- ═══ APP DOMAINS ════════════════════════════════════ -->
  <AppDomains>
    <AppDomain>https://kolslaw.com</AppDomain>
  </AppDomains>

  <!-- ═══ HOST REQUIREMENTS ═════════════════════════════ -->
  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <!-- ═══ DEFAULT SETTINGS ═══════════════════════════════ -->
  <!-- SourceLocation is required by the schema but never shown (no pane). -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://kolslaw.com/tc-converter/commands.html" />
  </DefaultSettings>

  <!-- ═══ PERMISSIONS ════════════════════════════════════ -->
  <Permissions>ReadWriteDocument</Permissions>

  <!-- ═══ RIBBON / VERSION OVERRIDES ════════════════════ -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>

          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="KolslawGroup">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>

                <!-- One-click smart toggle: detects direction automatically -->
                <Control xsi:type="Button" id="SmartToggleButton">
                  <Label resid="SmartToggle.Label" />
                  <Supertip>
                    <Title resid="SmartToggle.Label" />
                    <Description resid="SmartToggle.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>smartToggle</FunctionName>
                  </Action>
                </Control>

                <!-- Explicit conversions, with deletion style as menu items -->
                <Control xsi:type="Menu" id="ConvertMenu">
                  <Label resid="ConvertMenu.Label" />
                  <Supertip>
                    <Title resid="ConvertMenu.Label" />
                    <Description resid="ConvertMenu.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Items>
                    <Item id="ToUsptoMixedItem">
                      <Label resid="ToUsptoMixed.Label" />
                      <Supertip>
                        <Title resid="ToUsptoMixed.Label" />
                        <Description resid="ToUsptoMixed.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="Icon.16x16" />
                        <bt:Image size="32" resid="Icon.32x32" />
                        <bt:Image size="80" resid="Icon.80x80" />
                      </Icon>
                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>toUsptoMixed</FunctionName>
                      </Action>
                    </Item>
                    <Item id="ToUsptoStrikeItem">
                      <Label resid="ToUsptoStrike.Label" />
                      <Supertip>
                        <Title resid="ToUsptoStrike.Label" />
                        <Description resid="ToUsptoStrike.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="Icon.16x16" />
                        <bt:Image size="32" resid="Icon.32x32" />
                        <bt:Image size="80" resid="Icon.80x80" />
                      </Icon>
                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>toUsptoStrike</FunctionName>
                      </Action>
                    </Item>
                    <Item id="ToTcItem">
                      <Label resid="ToTc.Label" />
                      <Supertip>
                        <Title resid="ToTc.Label" />
                        <Description resid="ToTc.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="Icon.16x16" />
                        <bt:Image size="32" resid="Icon.32x32" />
                        <bt:Image size="80" resid="Icon.80x80" />
                      </Icon>
                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>toTrackedChanges</FunctionName>
                      </Action>
                    </Item>
                  </Items>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://kolslaw.com/tc-converter/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://kolslaw.com/tc-converter/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://kolslaw.com/tc-converter/icon-80.png" />
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://kolslaw.com/tc-converter/commands.html" />
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="CommandsGroup.Label"   DefaultValue="Kolslaw" />
        <bt:String id="SmartToggle.Label"     DefaultValue="Smart Toggle" />
        <bt:String id="ConvertMenu.Label"     DefaultValue="Convert" />
        <bt:String id="ToUsptoMixed.Label"    DefaultValue="TC → USPTO (Mixed, 37 CFR 1.121)" />
        <bt:String id="ToUsptoStrike.Label"   DefaultValue="TC → USPTO (Strikethrough Only)" />
        <bt:String id="ToTc.Label"            DefaultValue="USPTO → Tracked Changes" />
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="SmartToggle.Tooltip"   DefaultValue="Auto-detects the document state and converts: tracked changes → USPTO markup, or USPTO markup → tracked changes. Works on the selection if text is selected, otherwise the whole document." />
        <bt:String id="ConvertMenu.Tooltip"   DefaultValue="Explicit conversion direction and deletion style." />
        <bt:String id="ToUsptoMixed.Tooltip"  DefaultValue="Deletions of 4 characters or fewer become [[brackets]]; longer deletions become strikethrough. Insertions are underlined." />
        <bt:String id="ToUsptoStrike.Tooltip" DefaultValue="All deletions become strikethrough; insertions are underlined." />
        <bt:String id="ToTc.Tooltip"          DefaultValue="Converts underline, strikethrough, and [[bracket]] markup back into Word tracked changes for review." />
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
